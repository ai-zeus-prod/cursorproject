# ============================================
# INVESTMENT AGENT SYSTEM - CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# GENERAL SETTINGS
# ============================================
APP_NAME="Investment Strategy Agent"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ============================================
# DATABASE SETTINGS
# ============================================
# SQLite (Simple - Recommended for start)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/investment_agents.db

# ============================================
# USER INFORMATION
# ============================================
USER_NAME=Gavi
USER_EMAIL=your.email@example.com
USER_PHONE=+919876543210
USER_TIMEZONE=Asia/Kolkata

# ============================================
# TRADING SETTINGS
# ============================================
STARTING_CAPITAL=100000
MAX_POSITION_SIZE=25000
MAX_PORTFOLIO_ALLOCATION=0.70
DEFAULT_STOP_LOSS=0.07
TARGET_RETURN=0.20

# ============================================
# MARKET DATA APIs
# ============================================
# Yahoo Finance (Free - No key needed)
USE_YAHOO_FINANCE=True

# Alpha Vantage (Free tier: 5 calls/min, 500/day)
ALPHA_VANTAGE_KEY=your_key_here

# ============================================
# NOTIFICATION SETTINGS
# ============================================
# Email (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here

EMAIL_NOTIFICATIONS_ENABLED=True
MORNING_BRIEF_TIME=08:45
EOD_REPORT_TIME=16:00

# ============================================
# CLAUDE API (Optional - For Advanced Analysis)
# ============================================
CLAUDE_API_ENABLED=False
ANTHROPIC_API_KEY=your_anthropic_key_here

# ============================================
# AGENT SCHEDULING
# ============================================
AGENT_1_SCHEDULE=07:00
AGENT_2_SCHEDULE=07:30
AGENT_3_SCHEDULE=07:45
AGENT_6_SCHEDULE=08:30

# ============================================
# RISK MANAGEMENT
# ============================================
ENABLE_CIRCUIT_BREAKERS=True
MAX_DRAWDOWN_THRESHOLD=0.15
MIN_WIN_RATE_THRESHOLD=0.40
MAX_CONSECUTIVE_LOSSES=5

# ============================================
# PAPER TRADING (Safe Testing)
# ============================================
PAPER_TRADING_MODE=True

# ============================================
# ADVANCED SETTINGS
# ============================================
ENABLE_PATTERN_MATCHING=True
PATTERN_LOOKBACK_DAYS=1825
MIN_PATTERN_CONFIDENCE=0.65

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_AUTO_REFRESH=300

# Logging
LOG_FILE_PATH=./logs/agents.log
LOG_ROTATION=1 week
LOG_RETENTION=4 weeks
